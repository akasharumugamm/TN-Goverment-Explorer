# Amazon Cognito User Pool domain, including https:// and no trailing slash
COGNITO_DOMAIN=https://your-domain.auth.ap-southeast-2.amazoncognito.com

# App client values from Cognito. Keep the secret private.
COGNITO_CLIENT_ID=your_app_client_id
COGNITO_CLIENT_SECRET=your_app_client_secret

# Must exactly match an Allowed callback URL in Cognito.
COGNITO_CALLBACK_URL=https://akasharumugam.app/auth/callback

# Must exactly match an Allowed sign-out URL in Cognito.
COGNITO_SIGNOUT_URL=https://akasharumugam.app/

# Public review-image bucket name. The bucket itself must be configured separately.
S3_PUBLIC_IMAGES_BUCKET=replace-with-your-bucket-name

# AWS region containing the S3 bucket; use the EC2 instance role for AWS credentials.
AWS_REGION=ap-southeast-2
